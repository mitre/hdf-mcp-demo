# A locally-built hdf binary (point at it with HDF_BIN instead of committing)
/hdf
# Go test/coverage artifacts
*.test
*.out
coverage*

# Ad-hoc benchmark runs written by bench.sh are scratch — they accumulate on every
# invocation. Reports worth keeping (the study artifacts a card or the README cites)
# go in results/published/, which IS tracked.
results/*
!results/published/
